{
  "name": "the-unclaimed",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./tests/register.mjs --test tests/setup.test.mjs tests/start-investigation.test.mts tests/discovery.test.mts tests/browser-url.test.mts tests/archaeology.test.mts tests/wayback.test.mts tests/ai-grounding.test.mts tests/evidence-graph.test.mts tests/presence.test.mts tests/audio-library.test.mts tests/audio-manager.test.mts tests/sentry-scrub.test.mts tests/storage.test.mts tests/investigation.integration.test.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "audio:list": "node --experimental-strip-types --import ./tests/register.mjs scripts/generate-audio.mts --list",
    "audio:generate": "node --experimental-strip-types --import ./tests/register.mjs --env-file=.env.local scripts/generate-audio.mts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
