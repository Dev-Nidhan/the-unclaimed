    "@sentry/nextjs": "^11.10.0",
    "@xyflow/react": "^12.12.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "playwright-core": "^1.64.1",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
