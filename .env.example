# Copy this file to .env.local and put real values there.
# .env.local is gitignored. Leave every value in this file empty.

DATABASE_URL=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_REGION=
SERPAPI_API_KEY=
# Optional search limits. Empty values use 4 queries, 5 results each, and a 15000 ms timeout.
SEARCH_MAX_QUERIES=
SEARCH_RESULTS_PER_QUERY=
SEARCH_TIMEOUT_MS=
# Optional fieldwork limits. Empty values use depth 2, 15 pages, and a 2000 ms delay.
CRAWL_MAX_DEPTH=
CRAWL_MAX_PAGES=
CRAWL_DELAY_MS=
# Optional Wayback limits. Empty values check 5 sources and store up to 5 captures each.
ARCHIVE_MAX_SOURCES=
ARCHIVE_MAX_CAPTURES=
ARCHIVE_TIMEOUT_MS=
# Optional local model timeout in milliseconds. Empty uses 120000.
OLLAMA_TIMEOUT_MS=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
# Optional residual presence timings, in milliseconds.
# Empty values use a first event at 90–180 seconds, later events at 120–300 seconds, and a 75 second cooldown.
PRESENCE_FIRST_MIN_MS=
PRESENCE_FIRST_MAX_MS=
PRESENCE_NEXT_MIN_MS=
PRESENCE_NEXT_MAX_MS=
PRESENCE_COOLDOWN_MS=
PRESENCE_WEIGHT_COMMON=
PRESENCE_WEIGHT_UNCOMMON=
PRESENCE_WEIGHT_RARE=
# Used only when you run npm run audio:generate. The app does not call ElevenLabs.
ELEVENLABS_API_KEY=
# A voice you are allowed to use, from GET /v1/voices. Required for the whisper files.
ELEVENLABS_VOICE_ID=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Optional. Used only to upload source maps. The running app does not need it.
SENTRY_AUTH_TOKEN=
# Optional DigitalOcean Spaces. Required in production for artifact uploads/downloads.
# Development may use a private local folder when these are empty; production must not rely on local persistence.
# The SDK region stays us-east-1. Put the datacenter in SPACES_ENDPOINT, for example https://nyc3.digitaloceanspaces.com.
# SPACES_REGION is the datacenter slug and must match that host. SPACES_URL_TTL_SECONDS defaults to 900.
SPACES_ENDPOINT=
SPACES_BUCKET=
SPACES_REGION=
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
SPACES_URL_TTL_SECONDS=
